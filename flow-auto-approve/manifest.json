{
  "manifest_version": 3,
  "name": "Flow Oto-Onay",
  "version": "2.8.0",
  "description": "Promptları Google Flow sohbetine sırayla gönderir, her partide \"Devam et\" der ve bitince görselleri sırayla adlandırtır.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "action": {
    "default_title": "Flow Oto-Onay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
