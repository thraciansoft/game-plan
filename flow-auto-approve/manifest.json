{
  "manifest_version": 3,
  "name": "Flow Oto-Onay",
  "version": "1.0.0",
  "description": "Google Flow'un her toplu görsel üretiminden sonra sorduğu devam onayını otomatik verir.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Flow Oto-Onay",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
